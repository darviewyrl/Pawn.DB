file(MAKE_DIRECTORY "${OUTPUT}")
foreach(pair IN ITEMS "a_mysql|mysql_included" "omp_mysql|_INC_mysql" "omp-mysql|_INC_mysql")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 header)
  list(GET parts 1 guard)
  file(WRITE "${OUTPUT}/${header}.inc" "#if defined ${guard}\n#endinput\n#endif\n#define ${guard}\n#error Legacy declarations were not skipped.\n")
  file(WRITE "${OUTPUT}/after.pwn" "#define PAWNDB_COMPAT\n#include <pawndb>\n#include <${header}>\nmain() { new MySQL:h = MYSQL_INVALID_HANDLE; new Cache:c = MYSQL_INVALID_CACHE; h = PDB:c; return _:h; }\n")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT}/after.pwn" "-i${ROOT}/include" "-i${OUTPUT}" "-o${OUTPUT}/after.amx"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Include-after guard failed for ${header}: ${out}${err}")
  endif()
  file(WRITE "${OUTPUT}/before.pwn" "#define PAWNDB_COMPAT\n#define ${guard}\n#include <pawndb>\nmain() {}\n")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT}/before.pwn" "-i${ROOT}/include" "-o${OUTPUT}/before.amx"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(status EQUAL 0 OR NOT "${out}${err}" MATCHES "Remove the legacy MySQL include")
    message(FATAL_ERROR "Include-before guard did not reject ${header}: ${out}${err}")
  endif()
endforeach()
